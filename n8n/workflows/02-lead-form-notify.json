{
  "name": "QeydAI — Lead Form Notification",
  "nodes": [
    {
      "id": "lead-webhook",
      "name": "Lead Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [180, 240],
      "parameters": {
        "httpMethod": "POST",
        "path": "qeydai-lead",
        "authentication": "headerAuth",
        "responseMode": "responseNode",
        "options": {}
      },
      "credentials": {
        "httpHeaderAuth": {
          "id": "REPLACE_WEBHOOK_SECRET_CRED_ID",
          "name": "QeydAI Webhook Secret"
        }
      }
    },
    {
      "id": "validate-lead",
      "name": "Validate Lead Payload",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [420, 240],
      "parameters": {
        "jsCode": "const body = $json.body || {};\nconst name = typeof body.name === 'string' ? body.name.replace(/[\\u0000-\\u001f\\u007f]/g, ' ').trim().slice(0, 120) : '';\nconst phone = typeof body.phone === 'string' ? body.phone.trim() : '';\nconst valid = name.length >= 2 && /^\\+994(10|50|51|55|60|70|77|99)\\d{7}$/.test(phone);\nconst idempotencyKey = valid ? `${phone}:${new Date().toISOString().slice(0, 10)}` : '';\nreturn [{ json: { valid, name, phone, locale: body.locale === 'en' ? 'en' : 'az', idempotencyKey } }];"
      }
    },
    {
      "id": "if-valid",
      "name": "If Valid Lead",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [660, 240],
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": true, "typeValidation": "strict" },
          "conditions": [
            {
              "id": "c-valid",
              "leftValue": "={{ $json.valid }}",
              "rightValue": true,
              "operator": { "type": "boolean", "operation": "true" }
            }
          ],
          "combinator": "and"
        }
      }
    },
    {
      "id": "notify-admin",
      "name": "Notify Admin Telegram",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [900, 140],
      "parameters": {
        "chatId": "={{ $env.QEYDAI_ADMIN_CHAT_ID }}",
        "text": "={{ 'Yeni demo müraciəti (' + $json.locale.toUpperCase() + '): ' + $json.name + ' — ' + $json.phone }}"
      },
      "credentials": {
        "telegramApi": {
          "id": "REPLACE_TELEGRAM_CRED_ID",
          "name": "QeydAI Telegram Bot"
        }
      }
    },
    {
      "id": "respond-ok",
      "name": "Respond 200",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [1140, 140],
      "parameters": {
        "respondWith": "json",
        "responseBody": "={\"ok\":true}",
        "options": { "responseCode": 200 }
      }
    },
    {
      "id": "respond-bad",
      "name": "Respond 400",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [900, 340],
      "parameters": {
        "respondWith": "json",
        "responseBody": "={\"ok\":false,\"error\":\"invalid_lead\"}",
        "options": { "responseCode": 400 }
      }
    },
    {
      "id": "error-trigger",
      "name": "Error Trigger",
      "type": "n8n-nodes-base.errorTrigger",
      "typeVersion": 1,
      "position": [180, 480],
      "parameters": {}
    },
    {
      "id": "notify-error",
      "name": "Notify Admin on Error",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [420, 480],
      "parameters": {
        "chatId": "={{ $env.QEYDAI_ADMIN_CHAT_ID }}",
        "text": "={{ 'QeydAI lead webhook xətası: ' + ($json.execution?.lastNodeExecuted || 'unknown') }}"
      },
      "credentials": {
        "telegramApi": {
          "id": "REPLACE_TELEGRAM_CRED_ID",
          "name": "QeydAI Telegram Bot"
        }
      }
    }
  ],
  "connections": {
    "Lead Webhook": {
      "main": [[{ "node": "Validate Lead Payload", "type": "main", "index": 0 }]]
    },
    "Validate Lead Payload": {
      "main": [[{ "node": "If Valid Lead", "type": "main", "index": 0 }]]
    },
    "If Valid Lead": {
      "main": [
        [{ "node": "Notify Admin Telegram", "type": "main", "index": 0 }],
        [{ "node": "Respond 400", "type": "main", "index": 0 }]
      ]
    },
    "Notify Admin Telegram": {
      "main": [[{ "node": "Respond 200", "type": "main", "index": 0 }]]
    },
    "Error Trigger": {
      "main": [[{ "node": "Notify Admin on Error", "type": "main", "index": 0 }]]
    }
  },
  "active": false,
  "settings": {
    "executionOrder": "v1"
  }
}
