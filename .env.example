# ==============================================================================
# panelim.az — Production & Staging Environment Variables
# Copy to .env.local for local dev or configure in Vercel Project Settings.
# ==============================================================================

# --- Core Domain & Reverse Proxy ---
NEXT_PUBLIC_SITE_URL=https://panelim.az
TRUST_PROXY=vercel

# --- PostgreSQL (Neon — use sslmode=verify-full and non-owner app role!) ---
QEYDAI_DATABASE_URL=postgresql://app_user:password@ep-example.us-east-1.aws.neon.tech/neondb?sslmode=verify-full
# Migration-only privileged URL (used solely when running `npm run db:migrate`)
QEYDAI_MIGRATION_DATABASE_URL=postgresql://neondb_owner:password@ep-example.us-east-1.aws.neon.tech/neondb?sslmode=verify-full

# --- Authentication & Encryption ---
# Generate with: openssl rand -hex 32
QEYDAI_PANEL_SECRET=
# Optional dedicated 32+ char key for AES-256-GCM encryption of customer channel tokens
QEYDAI_CHANNELS_ENCRYPTION_KEY=
# Optional legacy access-key maps (JSON objects; leave {} when using email/OAuth accounts)
QEYDAI_ADMIN_KEYS={}
QEYDAI_API_KEYS={}

# --- Social OAuth (Google & Facebook) ---
QEYDAI_GOOGLE_CLIENT_ID=
QEYDAI_GOOGLE_CLIENT_SECRET=
QEYDAI_FACEBOOK_APP_ID=
QEYDAI_FACEBOOK_APP_SECRET=

# --- Transactional Email (Resend) ---
RESEND_API_KEY=
QEYDAI_EMAIL_FROM="panelim.az <noreply@panelim.az>"

# --- Pani AI (Groq) ---
GROQ_API_KEY=
# Optional override (defaults to llama-3.3-70b-versatile)
GROQ_MODEL=llama-3.3-70b-versatile

# --- Messaging Channels & Outbox Cron ---
# Vercel automatically injects CRON_SECRET when configured in Vercel Project Settings
CRON_SECRET=
QEYDAI_CRM_WORKER_KEY=
QEYDAI_META_APP_SECRET=
QEYDAI_META_VERIFY_TOKEN=
QEYDAI_META_GRAPH_VERSION=v22.0
# Optional legacy JSON array; customers can also connect channels self-serve in /panel
QEYDAI_CRM_CHANNELS=[]

# --- Public Demo Leads & Operations Alerts ---
# Your real CRM workspace ID (e.g. biz_...) so website demo leads appear in your inbox
QEYDAI_PUBLIC_LEAD_TENANT=
# Ops Telegram bot for lead notifications and server error alerts
QEYDAI_OPS_TELEGRAM_BOT_TOKEN=
QEYDAI_OPS_TELEGRAM_CHAT_ID=

# --- Billing (Paycell) ---
QEYDAI_PAYCELL_CHECKOUT_URL=
QEYDAI_PAYCELL_WEBHOOK_SECRET=

# --- Public Brand Contact, Socials & Legal Entity ---
# Digits only (e.g. 994501112233) — hides floating WhatsApp chat when empty
NEXT_PUBLIC_WHATSAPP_NUMBER=
NEXT_PUBLIC_CONTACT_PHONE=
NEXT_PUBLIC_CONTACT_EMAIL=info@panelim.az
NEXT_PUBLIC_TELEGRAM_URL=
NEXT_PUBLIC_INSTAGRAM_URL=
NEXT_PUBLIC_MESSENGER_URL=
NEXT_PUBLIC_PRODUCT_VIDEO_URL=
NEXT_PUBLIC_LEGAL_ENTITY_NAME=
NEXT_PUBLIC_LEGAL_ENTITY_VOEN=
NEXT_PUBLIC_LEGAL_ENTITY_ADDRESS=

# --- Analytics (optional, loaded only after user accepts cookies) ---
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_GTM_ID=
NEXT_PUBLIC_META_PIXEL_ID=
NEXT_PUBLIC_CLARITY_ID=
NEXT_PUBLIC_TIKTOK_PIXEL_ID=
NEXT_PUBLIC_LINKEDIN_PARTNER_ID=
NEXT_PUBLIC_BING_UET_ID=
