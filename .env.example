# Copy to .env.local for development. Never commit real values.
# Production values belong in the host's secret manager (e.g. Vercel env vars).

# --- Database (PostgreSQL / Neon). Use a limited, non-owner, non-BYPASSRLS role.
QEYDAI_DATABASE_URL=

# --- Panel and API auth
# Signing secret for panel sessions (long random string, same on every instance).
QEYDAI_PANEL_SECRET=
# JSON maps of key -> tenant id. Keys shorter than 24 chars are ignored.
# Example: {"<long-random-key>":"center_001"}
QEYDAI_ADMIN_KEYS=
QEYDAI_API_KEYS=
# Tenant that receives leads submitted from the public site forms.
QEYDAI_PUBLIC_LEAD_TENANT=

# --- Channels (Telegram / WhatsApp / Instagram)
# JSON list: [{"channel":"telegram|whatsapp|instagram","account":"...","tenant":"...","token":"...","secret":"(required for telegram)"}]
QEYDAI_CRM_CHANNELS=
# Key used by the cron/n8n job that calls /api/channels/deliver.
QEYDAI_CRM_WORKER_KEY=
QEYDAI_META_APP_SECRET=
QEYDAI_META_VERIFY_TOKEN=
# Format vNN.N, e.g. v21.0. Required for WhatsApp/Instagram sending.
QEYDAI_META_GRAPH_VERSION=

# --- Deployment
# Which proxy header carries the real client IP for rate limiting: x-real-ip or x-forwarded-for.
# Leave empty unless running behind a trusted proxy (proxy headers are ignored by default).
TRUST_PROXY=
NEXT_PUBLIC_SITE_URL=https://panelim.az
