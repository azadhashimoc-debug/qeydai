# Copy to .env.local for development. Never commit real values.
# Production values belong in the host's secret manager (e.g. Vercel env vars).

# --- Database (PostgreSQL / Neon). Use a limited, non-owner, non-BYPASSRLS role.
QEYDAI_DATABASE_URL=

# --- Panel and API auth
# Signing secret for panel sessions (long random string, same on every instance).
QEYDAI_PANEL_SECRET=
# JSON maps of key -> tenant id. Keys shorter than 24 chars are ignored.
# Example: {"<long-random-key>":"center_001"}
QEYDAI_ADMIN_KEYS=
QEYDAI_API_KEYS=
# Tenant that receives leads submitted from the public site forms.
QEYDAI_PUBLIC_LEAD_TENANT=

# --- Channels (Telegram / WhatsApp / Instagram)
# JSON list: [{"channel":"telegram|whatsapp|instagram","account":"...","tenant":"...","token":"...","secret":"(required for telegram)"}]
QEYDAI_CRM_CHANNELS=
# Key used by the cron/n8n job that calls /api/channels/deliver.
QEYDAI_CRM_WORKER_KEY=
QEYDAI_META_APP_SECRET=
QEYDAI_META_VERIFY_TOKEN=
# Format vNN.N, e.g. v21.0. Required for WhatsApp/Instagram sending.
QEYDAI_META_GRAPH_VERSION=

# --- AI auto-replies (Groq primary, NVIDIA NIM fallback). Both optional; no key = no auto replies.
GROQ_API_KEY=
NVIDIA_API_KEY=
# Optional: provider order and model overrides.
QEYDAI_AI_PROVIDER_ORDER=groq,nvidia
QEYDAI_AI_GROQ_MODEL=
QEYDAI_AI_NVIDIA_MODEL=
# Per-tenant business information the AI may answer from (services, prices, hours, address).
# JSON: {"center_001":"Manikür 20 AZN ... İş saatları 10:00-19:00 ..."}. No entry = AI stays off for that tenant.
QEYDAI_AI_KNOWLEDGE=

# --- Deployment
# Which proxy header carries the real client IP for rate limiting: x-real-ip or x-forwarded-for.
# Leave empty unless running behind a trusted proxy (proxy headers are ignored by default).
TRUST_PROXY=
NEXT_PUBLIC_SITE_URL=https://panelim.az

# --- Google / Facebook sign-in (optional; a provider's button appears only when both of its values are set)
# Redirect URIs to register: <NEXT_PUBLIC_SITE_URL>/api/auth/oauth/google/callback and .../facebook/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=

# --- E-mail sign-in link (optional; the form appears only when all three are set, incl. NEXT_PUBLIC_SITE_URL)
# Resend (https://resend.com). EMAIL_FROM must be an address on a domain verified in Resend, e.g. "panelim.az <noreply@panelim.az>".
RESEND_API_KEY=
EMAIL_FROM=

